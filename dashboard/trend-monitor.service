# systemd 服务：sudo cp trend-monitor.service /etc/systemd/system/ 后修改路径和用户
[Unit]
Description=Trend signal dashboard and Telegram monitor
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/strategies
ExecStart=/usr/bin/python3 dashboard/monitor.py --host 127.0.0.1 --port 8765
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
